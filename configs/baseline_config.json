{
  "model": "efficientnet_b0",
  "num_classes": 1588,
  "input_size": 224,
  "batch_size": 64,
  "epochs": 50,
  "optimizer": "adamw",
  "lr": 0.001,
  "weight_decay": 0.0001,
  "lr_schedule": "cosine",
  "warmup_epochs": 3,
  "label_smoothing": 0.1,
  "early_stopping_patience": 10,
  "mixed_precision": false,
  "device": "mps",
  "workers": 0,
  "augmentation": {
    "random_resized_crop": true,
    "randaugment": true,
    "randaugment_n": 2,
    "randaugment_m": 9,
    "horizontal_flip": false,
    "vertical_flip": false,
    "rotation": 5.0,
    "color_jitter": {"brightness": 0.1, "contrast": 0.1, "saturation": 0.1, "hue": 0.02},
    "normalize_mean": [0.485, 0.456, 0.406],
    "normalize_std": [0.229, 0.224, 0.225]
  },
  "val_augmentation": {
    "resize": 256,
    "center_crop": 224,
    "normalize_mean": [0.485, 0.456, 0.406],
    "normalize_std": [0.229, 0.224, 0.225]
  }
}
